# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=production

# Allocator's own database (docker-compose builds DATABASE_URL from this).
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://allocator:<password>@localhost:5432/allocator

# SMARTTT, the only system the Allocator talks to.
SMARTTT_BASE_URL=https://api.nextup.co.ke
# Must equal ALLOCATOR_API_KEY in SMARTTT. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SMARTTT_API_KEY=
SMARTTT_TIMEOUT_SECONDS=15
# Cache for reads from SMARTTT, at most 60 seconds.
SMARTTT_CACHE_SECONDS=60

# The Timetable Generator, where the Director's office enters units and groups.
# The allocation form reads them from its /api/integrations/allocator/ endpoints.
GENERATOR_BASE_URL=http://localhost:8001
# Must equal ALLOCATOR_API_KEY in the Generator (generate as above).
GENERATOR_API_KEY=
GENERATOR_TIMEOUT_SECONDS=15

# Sign-in sessions.
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
IDENTITY_REFRESH_SECONDS=300
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# Only needed when the web app is served from a different origin than the API.
CORS_ORIGINS=

LOG_LEVEL=INFO
