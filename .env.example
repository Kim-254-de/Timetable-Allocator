# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=production

# Allocator's own database (docker-compose builds DATABASE_URL from this). Letters
# and digits only, as it goes into a URL:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://allocator:<password>@localhost:5432/allocator

# SMARTTT, the only system the Allocator talks to.
SMARTTT_BASE_URL=https://api.nextup.co.ke
# Must equal ALLOCATOR_API_KEY in SMARTTT. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SMARTTT_API_KEY=
SMARTTT_TIMEOUT_SECONDS=15
# Cache for reads from SMARTTT, at most 60 seconds.
SMARTTT_CACHE_SECONDS=60

# The Timetable Generator: its terms, and each class's day, time and room once
# the Director publishes, read from its /api/integrations/allocator/ endpoints.
# In Docker: the Generator's address as this server reaches it, e.g.
# https://generator.tharaka.ac.ke (its web app forwards /api); never localhost.
GENERATOR_BASE_URL=http://localhost:8002
# Must equal ALLOCATOR_API_KEY in the Generator (generate as above).
GENERATOR_API_KEY=
GENERATOR_TIMEOUT_SECONDS=15
# The key the Generator presents to read what departments have published
# (/api/integrations/generator/...). Must equal ALLOCATOR_CLIENT_KEY in the
# Generator (generate as above). Unset, the Generator can't import.
GENERATOR_INBOUND_KEY=

# Sign-in sessions.
# Needs HTTPS in front of the web app; false only for local development.
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
IDENTITY_REFRESH_SECONDS=300
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# Only needed when the web app is served from a different origin than the API.
CORS_ORIGINS=

LOG_LEVEL=INFO
